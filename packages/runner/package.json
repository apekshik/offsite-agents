{
  "name": "offsite-agents",
  "version": "0.1.0",
  "description": "Run your Offsite crew on this machine, on your own Claude Code and Codex subscriptions. One command: npx offsite-agents",
  "keywords": ["offsite", "claude-code", "codex", "agents", "coding-agents", "runner"],
  "homepage": "https://offsiteagents.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apekshik/offsite-agents.git",
    "directory": "packages/runner"
  },
  "bugs": "https://github.com/apekshik/offsite-agents/issues",
  "type": "module",
  "license": "MIT",
  "bin": {
    "offsite-agents": "dist/offsite.mjs",
    "offsite": "dist/offsite.mjs"
  },
  "files": [
    "dist/offsite.mjs",
    "dist/LICENSE",
    "dist/NOTICE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "convex": "^1.46.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@offsite/contracts": "workspace:*",
    "@offsite/git": "workspace:*",
    "@offsite/harness": "workspace:*",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2"
  }
}

{
  "name": "offsite-agents-root",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @offsite/web dev",
    "dev:backend": "convex dev",
    "runner": "node --experimental-strip-types --no-warnings packages/runner/src/cli.ts",
    "sim": "node --experimental-strip-types --no-warnings packages/runner/src/cli.ts start --sim",
    "build": "pnpm --filter @offsite/web build && node scripts/pack-runner.mjs",
    "typecheck": "pnpm -r typecheck && tsc -p convex",
    "test": "pnpm -r test && pnpm test:backend",
    "test:backend": "vitest run --config convex/vitest.config.ts",
    "film": "node scripts/film/film.mjs",
    "film:stills": "node scripts/film/film.mjs --stills",
    "video": "node scripts/video/build.mjs"
  },
  "dependencies": {
    "@offsite/contracts": "workspace:*",
    "convex": "^1.46.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.10.0",
    "convex-test": "^0.0.60",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "vitest": "^3.2.0"
  }
}
